# RootPatch Backend Environment Configuration (Placeholders Only)
ROOTPATCH_WORKSPACE_DIR=backend/workspace
ROOTPATCH_MAX_UPLOAD_BYTES=52428800
ROOTPATCH_MAX_EXTRACTED_FILES=5000
ROOTPATCH_MAX_EXTRACTED_TOTAL_BYTES=209715200
ROOTPATCH_MAX_EXTRACTED_FILE_BYTES=26214400
ROOTPATCH_MAX_STRUCTURE_NODES=5000
ROOTPATCH_MAX_SCAN_FILES=1000
ROOTPATCH_MAX_SCAN_FILE_BYTES=2097152
ROOTPATCH_SCANNER_TIMEOUT_SECONDS=30
ROOTPATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Step 4: AI-Powered Root Cause Analysis
ROOTPATCH_LLM_PROVIDER=gemini
ROOTPATCH_LLM_MODEL=gemini-4-hydrogen
ROOTPATCH_LLM_API_KEY=your-llm-api-key-here
# Optional provider-specific fallback keys (never commit real keys):
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ROOTPATCH_LLM_BASE_URL=
ROOTPATCH_LLM_TIMEOUT_SECONDS=30
ROOTPATCH_CONTEXT_LINES_BEFORE=20
ROOTPATCH_CONTEXT_LINES_AFTER=20
ROOTPATCH_MAX_CONTEXT_FILE_BYTES=524288
ROOTPATCH_MAX_CONTEXT_CHARS_PER_FINDING=8000
ROOTPATCH_MAX_TOTAL_CONTEXT_CHARS=32000
ROOTPATCH_MAX_FINDINGS_PER_ANALYSIS=50

# Step 5: Automated Patch Generation
ROOTPATCH_MAX_PATCH_DIFF_BYTES=262144
ROOTPATCH_MAX_PATCH_HUNKS=25
ROOTPATCH_MAX_PATCHES_PER_RUN=25

# Step 7: Testing and Patch Validation (Docker Isolation)
ROOTPATCH_VALIDATION_TIMEOUT_SECONDS=60
ROOTPATCH_VALIDATION_MEMORY_LIMIT=512m
ROOTPATCH_VALIDATION_CPUS=1.0
ROOTPATCH_VALIDATION_PIDS_LIMIT=64
ROOTPATCH_MAX_VALIDATION_OUTPUT_BYTES=65536
ROOTPATCH_VALIDATION_PYTHON_IMAGE=python:3.11-slim
ROOTPATCH_VALIDATION_NODE_IMAGE=node:20-slim
ROOTPATCH_VALIDATION_NETWORK_DISABLED=true
