# RootPatch local Windows Docker validation worker configuration.
# Keep this file local. Never commit a real worker token.

ROOTPATCH_BACKEND_URL=https://rootpatch.onrender.com
ROOTPATCH_WORKER_TOKEN=replace-with-a-long-random-secret
ROOTPATCH_WORKER_ID=windows-laptop-worker-1
ROOTPATCH_DOCKER_BINARY=docker
ROOTPATCH_POLL_INTERVAL_SECONDS=5
ROOTPATCH_HEARTBEAT_INTERVAL_SECONDS=10
ROOTPATCH_JOB_LEASE_SECONDS=120
ROOTPATCH_MAX_RESULT_BYTES=65536
ROOTPATCH_TEMP_DIR=
