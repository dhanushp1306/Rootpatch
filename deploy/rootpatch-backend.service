[Unit]
Description=RootPatch AI Bug Detection and Patch Validation Backend
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=rootpatch
Group=rootpatch
# Supplementary group required to access /var/run/docker.sock for Step 7 container isolation
SupplementaryGroups=docker

WorkingDirectory=/var/www/rootpatch/backend
EnvironmentFile=/etc/rootpatch/rootpatch.env

# Exactly ONE worker process is required because RootPatch uses process-local threading locks
# (_PROJECT_LOCKS, _ACTIVE_GENERATIONS) for atomic patch application and conflict prevention.
ExecStart=/var/www/rootpatch/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Systemd Sandboxing and Hardening Directives
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

# Filesystem permissions: Application code is read-only; persistent workspace is writable
ReadOnlyPaths=/var/www/rootpatch/backend
ReadWritePaths=/var/lib/rootpatch/workspace

# File descriptor limits for high concurrent connections
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
