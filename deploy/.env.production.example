# ==============================================================================
# RootPatch Production Environment Configuration Template
# Path on target server: /etc/rootpatch/rootpatch.env
# Permissions: chmod 600 /etc/rootpatch/rootpatch.env (readable ONLY by rootpatch user)
# ==============================================================================

# --- Storage & Workspace ---
# Dedicated persistent NVMe storage for uploaded archives, source files, and patches.
# Ensure this directory is owned by the rootpatch user (chown -R rootpatch:rootpatch /var/lib/rootpatch/workspace).
ROOTPATCH_WORKSPACE_DIR=/var/lib/rootpatch/workspace

# Limits for uploaded project archives
ROOTPATCH_MAX_UPLOAD_BYTES=52428800           # 50 MB ZIP upload limit
ROOTPATCH_MAX_EXTRACTED_FILES=5000            # Maximum uncompressed files per project
ROOTPATCH_MAX_EXTRACTED_TOTAL_BYTES=209715200 # 200 MB maximum uncompressed size
ROOTPATCH_MAX_EXTRACTED_FILE_BYTES=26214400   # 25 MB maximum single file size
ROOTPATCH_MAX_STRUCTURE_NODES=5000            # Structure inspection node limit

# --- Step 3: Static Bug Detection ---
ROOTPATCH_MAX_SCAN_FILES=1000
ROOTPATCH_MAX_SCAN_FILE_BYTES=2097152         # 2 MB per scanned file
ROOTPATCH_SCANNER_TIMEOUT_SECONDS=30

# --- CORS Configuration ---
# If Caddy reverse-proxies both frontend and backend on the same domain, CORS is not required.
# However, if frontend and backend ever live on separate origins, specify your public frontend domain here:
ROOTPATCH_CORS_ORIGINS=https://rootpatch.yourdomain.com

# --- Step 4: AI Root-Cause Analysis (Groq via OpenAI-Compatible REST API) ---
ROOTPATCH_LLM_PROVIDER=openai-compatible
ROOTPATCH_LLM_MODEL=llama-3.3-70b-versatile
ROOTPATCH_LLM_API_KEY=YOUR_GROQ_API_KEY_HERE
ROOTPATCH_LLM_BASE_URL=https://api.groq.com/openai/v1
ROOTPATCH_LLM_TIMEOUT_SECONDS=60

# Context and token budgets for prompt construction
ROOTPATCH_CONTEXT_LINES_BEFORE=20
ROOTPATCH_CONTEXT_LINES_AFTER=20
ROOTPATCH_MAX_CONTEXT_FILE_BYTES=524288       # 512 KB
ROOTPATCH_MAX_CONTEXT_CHARS_PER_FINDING=8000
ROOTPATCH_MAX_TOTAL_CONTEXT_CHARS=32000
ROOTPATCH_MAX_FINDINGS_PER_ANALYSIS=50

# --- Step 5: Automated Patch Generation ---
ROOTPATCH_MAX_PATCH_DIFF_BYTES=262144         # 256 KB max unified diff size
ROOTPATCH_MAX_PATCH_HUNKS=25
ROOTPATCH_MAX_PATCHES_PER_RUN=25

# --- Step 7: Isolated Container Patch Validation ---
# Use the pre-built hardened Python validation image containing pytest:
ROOTPATCH_VALIDATION_PYTHON_IMAGE=rootpatch-python-validate:latest
ROOTPATCH_VALIDATION_NODE_IMAGE=node:20-slim

# Enforce strict container isolation guarantees:
ROOTPATCH_VALIDATION_NETWORK_DISABLED=true   # Inbound/outbound network completely disabled
ROOTPATCH_VALIDATION_TIMEOUT_SECONDS=60      # Maximum test execution runtime
ROOTPATCH_VALIDATION_MEMORY_LIMIT=512m       # Max container RAM
ROOTPATCH_VALIDATION_CPUS=1.0                # Max container CPU allocation
ROOTPATCH_VALIDATION_PIDS_LIMIT=64           # Max processes inside container (prevents fork bombs)
ROOTPATCH_MAX_VALIDATION_OUTPUT_BYTES=65536  # 64 KB test output limit
